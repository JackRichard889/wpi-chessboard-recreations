{
	"name": "wpi-chessboard-recreations",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node_modules/.bin/vite dev",
		"build": "node_modules/.bin/vite build",
		"preview": "node_modules/.bin/vite preview",
		"prepare": "node_modules/.bin/svelte-kit sync || echo ''",
		"check": "node_modules/.bin/svelte-kit sync && svelte-check --tsconfig tsconfig.json",
		"check:watch": "node_modules/.bin/svelte-kit sync && svelte-check --tsconfig tsconfig.json --watch",
		"format": "node_modules/.bin/prettier --write .",
		"lint": "node_modules/.bin/prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"konva": "^9.0.0",
		"svelte-konva": "^1.0.0-next.0"
	}
}
